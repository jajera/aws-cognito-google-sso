                <mxCell id="legend-2-text" value="&lt;b&gt;Retrieve private assets&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;CloudFront signs requests to the private S3 origin with OAC.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;whiteSpace=wrap;labelBackgroundColor=none;" parent="legend-container" vertex="1">
