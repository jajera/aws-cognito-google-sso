                </mxCell>
                <mxCell id="legend-5-text" value="&lt;b&gt;Apply optional email allowlist&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;If Phase 2 is enabled, Cognito invokes Lambda on pre-sign-up and rejects unauthorized emails.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;whiteSpace=wrap;labelBackgroundColor=none;" parent="legend-container" vertex="1">
